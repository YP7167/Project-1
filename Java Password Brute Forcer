public class PasswordCracker {
  public static void main(String args[]) {
      
      String password = "abc";
      char[] alphabet = "abcdefghijklmnopqrstuvwxyz".toCharArray();
      char[] guess = {'a', 'a', 'a'};
      int attempt = 1;
      
      while (true)
      {
          String passwordGuess = new String(guess);
          System.out.println("[Attempt " + attempt + "]: " + passwordGuess);
          attempt++;
          
          if (passwordGuess.equals(password))
          {
              System.out.println("[Correct Guess]: " + passwordGuess);
              break;
          }
          
          for (int i = guess.length-1; i >= 0; i--)
          {
              if (guess[i] < 'z')
              {
                  guess[i]++;
                  break;
              }
              else
              {
                  guess[i] = 'a';
              }
          }
      }
  }
}
